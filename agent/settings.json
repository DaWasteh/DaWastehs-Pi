{
  "lastChangelogVersion": "0.84.2",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "llamaServerUrl": "http://127.0.0.1:1234",
  "packages": [
    "npm:pi-llama-cpp",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:pi-hermes-memory",
    "npm:@casualjim/pi-heimdall",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-i18n",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@gaodes/pi-graphify",
    "npm:@xynogen/pix-optimizer",
    "npm:pi-subagents",
    "npm:pi-intercom",
    "npm:pi-prompt-template-model"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 131072
  },
  "thinkingBudgets": {
    "minimal": 2048,
    "low": 8192,
    "medium": 32768,
    "high": 65536
  },
  "defaultThinkingLevel": "max",
  "theme": "stargate-sg1",
  "httpIdleTimeoutMs": 0,
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.3-codex-spark",
    "defaultThinking": "low",
    "agentOverrides": {
      "advisor": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "low"
      },
      "scout": {
        "description": "Fast mechanical repository reconnaissance for bounded tasks that fit within 128k tokens.",
        "model": "openai-codex/gpt-5.3-codex-spark",
        "thinking": "low"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "low"
      },
      "context-builder": {
        "description": "Mechanical context gathering and repository mapping for bounded tasks below 128k tokens.",
        "model": "openai-codex/gpt-5.3-codex-spark",
        "thinking": "low"
      },
      "delegate": {
        "description": "Lightweight mechanical delegation for obvious, tightly scoped tasks below 128k tokens.",
        "model": "openai-codex/gpt-5.3-codex-spark",
        "thinking": "low"
      },
      "teamleiter": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "bugtester": {
        "description": "Targeted reproduction and mechanical regression testing for bounded bugs below 128k tokens.",
        "model": "openai-codex/gpt-5.3-codex-spark",
        "thinking": "low"
      },
      "mechanic": {
        "description": "Small obvious bug fixes and repository chores that need no architectural judgment and fit within 128k tokens.",
        "model": "openai-codex/gpt-5.3-codex-spark",
        "thinking": "low"
      },
      "web-searcher": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "low"
      }
    }
  }
}
